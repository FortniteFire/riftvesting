---
import '../styles/global.css';
import { url } from '../lib/format';
interface Props { title: string; description?: string; current?: string }
const { title, description = 'Riftbound graded-card market data: recent sales, 30-day trends and populations for PSA and BGS slabs.', current = '' } = Astro.props;
const nav = [ ['/', 'Home', 'home'], ['/sets/ogn/', 'Sets', 'sets'], ['/shop/', 'Shop', 'shop'], ['/about/', 'About', 'about'] ];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · Riftvesting</title>
    <meta name="description" content={description} />
    <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  </head>
  <body>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href={url('/')}>Riftvesting <span>· market report</span></a>
        <nav class="nav" aria-label="Main">
          {nav.map(([href, label, key]) => <a href={url(href)} aria-current={current === key ? 'page' : undefined}>{label}</a>)}
        </nav>
      </div>
    </header>
    <main class="wrap">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <span>Source: eBay, ALT and PWCC completed sales. Stats exclude unpaid sales.</span>
        <span><a href="https://x.com/Riftvesting">@Riftvesting</a> · Not financial advice</span>
      </div>
    </footer>
  </body>
</html>
