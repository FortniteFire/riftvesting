---
import Base from '../layouts/Base.astro';
import PriceCard from '../components/PriceCard.astro';
import { loadCards, loadSets, allSales, mover, gradeStats } from '../lib/data';
import { url, dateLong, pct } from '../lib/format';

const cards = loadCards();
const sets = loadSets();
const sales = allSales();
// latest notable sale per card × grade, newest first
const seen = new Set<string>();
const notable = sales.filter((r) => r.sale.price >= 1000).filter((r) => { const k = r.card.card.id + '|' + r.grade; if (seen.has(k)) return false; seen.add(k); return true; }).slice(0, 6);

const movers = cards.flatMap((card) => Object.entries(card.grades).map(([grade, g]) => ({ card, grade, m: mover(g) }))).filter((x) => x.m);
const up = [...movers].sort((a, b) => b.m!.pct - a.m!.pct).slice(0, 3);
const down = [...movers].sort((a, b) => a.m!.pct - b.m!.pct).slice(0, 3);

const valued = cards.flatMap((card) => Object.entries(card.grades).map(([grade, g]) => ({ card, grade, s: gradeStats(g) })))
  .filter((x) => x.s.last).sort((a, b) => b.s.last!.price - a.s.last!.price).slice(0, 6);

const setCounts = sets.map((s) => {
  const slots = s.sections.flatMap((x) => x.slots);
  return { ...s, total: slots.length, tracked: slots.filter((x) => x.card_id).length };
});
const totalSales = sales.length;
const latest = sales[0]?.sale.date;
---
<Base title="Riftbound graded market data" current="home">
  <section class="hero">
    <div class="eyebrow">Riftbound market report</div>
    <h1 class="page-title">Price Check</h1>
    <p class="lede">Completed sales for PSA and BGS Riftbound slabs, tracked card by card. {cards.length} cards, {totalSales.toLocaleString('en-US')} sales, updated {dateLong(latest)}.</p>
  </section>

  <section class="section">
    <div class="section-head"><h2>Recent notable sales</h2><span class="count">$1,000 and up · newest first</span></div>
    <div class="pc-grid">{notable.map(({ card, grade }) => <PriceCard card={card} grade={grade} />)}</div>
  </section>

  <section class="section">
    <div class="section-head"><h2>Biggest movers · 30 days</h2><span class="count">30-day median vs the 30 days before</span></div>
    {movers.length ? (
      <div class="pc-grid">{[...up, ...down].map(({ card, grade, m }) => <PriceCard card={card} grade={grade} kicker={`30-day median ${pct(m!.pct)}`} />)}</div>
    ) : <div class="panel muted">Not enough sales yet to compare two 30-day windows.</div>}
  </section>

  <section class="section">
    <div class="section-head"><h2>Highest last sale</h2></div>
    <div class="pc-grid">{valued.map(({ card, grade }) => <PriceCard card={card} grade={grade} />)}</div>
  </section>

  <section class="section">
    <div class="section-head"><h2>Sets</h2></div>
    <div class="set-grid">
      {setCounts.map((s) => (
        <a class="panel set-card" href={url(`/sets/${s.code.toLowerCase()}/`)}>
          <div class="eyebrow">{s.code}</div>
          <h3>{s.name}</h3>
          <div class="muted small">{s.tracked} of {s.total} slots tracked{s.released ? ` · released ${dateLong(s.released)}` : ''}</div>
          <div class="bar"><span style={`width:${s.total ? Math.round((100 * s.tracked) / s.total) : 0}%`}></span></div>
        </a>
      ))}
    </div>
  </section>
</Base>

<style>
  .hero { padding: 40px 0 8px; }
  .pc-grid { display: grid; gap: 16px; grid-template-columns: repeat(auto-fill, minmax(min(100%, 360px), 1fr)); }
  .set-grid { display: grid; gap: 12px; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); }
  .set-card h3 { font-size: 22px; margin: 4px 0 6px; }
  .set-card:hover { border-color: #3a5182; }
  .bar { height: 6px; border-radius: 3px; background: var(--navy-2); margin-top: 12px; overflow: hidden; }
  .bar span { display: block; height: 100%; background: linear-gradient(90deg, var(--gold), var(--gold-2)); }
</style>
